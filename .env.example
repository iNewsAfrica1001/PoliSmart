NODE_ENV=development
PORT=4000
HOST=127.0.0.1
APP_URL=http://127.0.0.1:5173
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
CLIENT_ORIGIN=http://127.0.0.1:5173
VITE_API_BASE=http://127.0.0.1:4000
PERSISTENCE_MODE=postgresql
DATABASE_URL=postgresql://polismart:polismart@127.0.0.1:5432/polismart_africa?schema=public
# Administrative migration connection. Never expose to the running application.
MIGRATION_DATABASE_URL=
# Vercel production: STORAGE_PROVIDER=vercel-blob and connect a private Blob store.
STORAGE_PROVIDER=local
DOCUMENT_STORAGE_PATH=./storage/documents
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
# Vercel production: use Resend, or EMAIL_PROVIDER=smtp with a verified SMTP sender.
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=PoliSmart Africa AI <noreply@polismartafrica.ai>
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# Use a managed Redis service before horizontal production scaling.
REDIS_URL=
# Server-only. Never prefix this variable with VITE_ or commit a real value.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
AI_PROVIDER=openai
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX_REQUESTS=12
JSON_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=180
