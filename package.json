{
  "name": "polismart-africa-ai",
  "version": "1.0.0",
  "description": "AI-powered political campaign intelligence and management platform designed for African political and governance environments.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "vite --host 127.0.0.1 --port 5173",
    "server": "node server.js",
    "start": "node server.js",
    "start:prod": "node -e \"process.env.NODE_ENV='production'; import('./server.js')\"",
    "build": "prisma generate && vite build",
    "vercel-build": "prisma generate && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "mobile:sync": "npm run build && cap sync",
    "mobile:android": "npm run mobile:sync && cap open android",
    "mobile:ios": "npm run mobile:sync && cap open ios",
    "check": "npm run lint && npm run typecheck",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "verify:prod": "npm run check && npm test && npm run build",
    "verify:local": "npm run check && npm test && npm run build",
    "verify:running": "npm run smoke",
    "smoke": "node scripts/smoke-test.mjs",
    "diagnose:email:graph": "node scripts/diagnose-microsoft-graph-email.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:production": "node scripts/migrate-production.mjs",
    "db:validate:production": "node scripts/validate-production-database.mjs",
    "db:seed": "prisma db seed",
    "import:afrobarometer": "node scripts/import-afrobarometer.mjs",
    "import:afrobarometer:production": "node scripts/import-afrobarometer-production.mjs"
  },
  "dependencies": {
    "@azure/msal-node": "^5.6.0",
    "@capacitor/core": "^8.4.1",
    "@prisma/client": "^6.12.0",
    "@tailwindcss/vite": "^4.3.0",
    "@vercel/blob": "^2.8.0",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.16.0",
    "mammoth": "^1.12.1",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "openai": "^7.5.0",
    "pdf-parse": "^1.1.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.8.1",
    "tailwindcss": "^4.3.0",
    "vite": "^7.1.7",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@eslint/js": "^9.34.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "concurrently": "^9.2.1",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "prisma": "^6.12.0",
    "supertest": "^7.2.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "allowScripts": {
    "@prisma/client@6.12.0": true,
    "@prisma/engines@6.12.0": true,
    "esbuild@0.28.2": true,
    "prisma@6.12.0": true
  }
}
