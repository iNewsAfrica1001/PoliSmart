  decision     ReviewDecision
  note         String?
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  policyCase   PolicyCase     @relation(fields: [policyCaseId], references: [id], onDelete: Cascade)
  reviewer     AuthUser       @relation("PolicyReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([tenantId, policyCaseId, createdAt])
