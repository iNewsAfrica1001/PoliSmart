  errorCode    String      @map("error_code")
  safeMessage  String      @map("safe_message")
  metadata     Json?
  createdAt    DateTime    @default(now()) @map("created_at")
  usageLog     AiUsageLog? @relation(fields: [aiUsageLogId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@map("ai_error_reports")
}
