  @@unique([providerKey, modelKey])
  @@map("ai_provider_records")
}

model PromptTemplateVersion {
  id          String       @id @default(uuid()) @db.Uuid
  templateKey String       @map("template_key")
  version     Int
  purpose     String
  templateSha String       @map("template_sha")
  template    String
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  usageLogs   AiUsageLog[]

  @@unique([templateKey, version])
  @@index([templateKey, isActive])
  @@map("prompt_template_versions")
}

model AiUsageLog {
  id                       String                   @id @default(uuid()) @db.Uuid
  tenantId                 String?                  @map("tenant_id") @db.Uuid
  campaignId               String?                  @map("campaign_id") @db.Uuid
  actorId                  String?                  @map("actor_id") @db.Uuid
  providerRecordId         String?                  @map("provider_record_id") @db.Uuid
  promptTemplateVersionId  String?                  @map("prompt_template_version_id") @db.Uuid
  feature                  String
  requestId                String?                  @map("request_id")
  generatedOutputReference String?                  @map("generated_output_reference")
  reviewerId               String?                  @map("reviewer_id") @db.Uuid
  approvalStatus           GovernanceApprovalStatus @default(NOT_REQUIRED) @map("approval_status")
  safetyFlags              Json                     @map("safety_flags")
  sourceGroundingMetadata  Json                     @map("source_grounding_metadata")
  providerResponseId       String?                  @map("provider_response_id")
  inputSha256              String                   @map("input_sha256")
  status                   String
  createdAt                DateTime                 @default(now()) @map("created_at")
  providerRecord           AiProviderRecord?        @relation(fields: [providerRecordId], references: [id], onDelete: Restrict)
  promptTemplateVersion    PromptTemplateVersion?   @relation(fields: [promptTemplateVersionId], references: [id], onDelete: Restrict)
  errors                   AiErrorReport[]

  @@index([tenantId, createdAt])
  @@index([campaignId, feature, createdAt])
  @@map("ai_usage_logs")
}

model AiErrorReport {
  id           String      @id @default(uuid()) @db.Uuid
  tenantId     String?     @map("tenant_id") @db.Uuid
  aiUsageLogId String?     @map("ai_usage_log_id") @db.Uuid
