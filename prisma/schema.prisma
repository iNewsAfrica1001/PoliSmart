  publisher          String
  publishedAt        DateTime           @map("published_at")
  topic              String
  geography          String
  source             String
  sourceUrl          String             @map("source_url")
  summary            String
  aggregateSentiment AggregateSentiment @default(UNKNOWN) @map("aggregate_sentiment")
