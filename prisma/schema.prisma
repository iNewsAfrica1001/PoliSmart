  @@unique([policyCaseId, version])
  @@index([tenantId, policyCaseId, createdAt])
  @@map("policy_revisions")
}

model PolicyApproval {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  policyCaseId String         @map("policy_case_id") @db.Uuid
