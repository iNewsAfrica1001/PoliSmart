generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  SUPER_ADMINISTRATOR
  CAMPAIGN_ADMINISTRATOR
  CANDIDATE
  CAMPAIGN_MANAGER
  POLICY_DIRECTOR
  COMMUNICATIONS_DIRECTOR
  FIELD_DIRECTOR
  VOLUNTEER_COORDINATOR
  ANALYST
  VOLUNTEER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum WorkStatus {
  PLANNED
  ACTIVE
  AT_RISK
  BLOCKED
  COMPLETED
  CANCELLED
}

enum WorkPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum EventType {
  RALLY
  TOWN_HALL
  PRESS_CONFERENCE
  COMMUNITY_MEETING
  VOLUNTEER_TRAINING
  POLICY_FORUM
  CANDIDATE_VISIT
  INTERNAL_MEETING
}

enum TrainingStatus {
  NOT_STARTED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  EXEMPT
}

enum ParticipationStatus {
  INVITED
  REGISTERED
  ATTENDED
  CANCELLED
  NO_SHOW
}

enum DocumentCategory {
  MANIFESTO
  POLICY
  SPEECH
  RESEARCH
  CAMPAIGN_MANUAL
  STRATEGY
  APPROVED_COMMUNICATION
  PUBLIC_REPORT
}

enum DocumentVisibility {
  PRIVATE
  CAMPAIGN
  ORGANIZATION
  PUBLIC
}

enum DocumentApprovalStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

enum DocumentProcessingStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum SurveyImportStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum SurveyMappingStatus {
  MAPPED
  UNMAPPED
}

enum IntelligenceCategory {
  PUBLIC_PRIORITIES
  ECONOMIC_CONDITIONS
  GOVERNMENT_PERFORMANCE
  INSTITUTIONAL_TRUST
  DEMOCRACY
  GOVERNANCE
  CORRUPTION
  PUBLIC_SERVICES
  SECURITY
  CIVIC_PARTICIPATION
  ELECTIONS
  YOUTH
  UNMAPPED
}

enum AiMessageRole {
  USER
  ASSISTANT
}

enum AiFeedbackType {
  HELPFUL
  INCORRECT
  REPORT
}

enum PolicyWorkflowStatus {
  PROBLEM
  EVIDENCE
  RESEARCH
  OPTIONS
  AI_DRAFT
  HUMAN_REVIEW
  APPROVED
  REJECTED
}

enum CommunicationType {
  SPEECH
  PRESS_RELEASE
  POLICY_EXPLANATION
  ANNOUNCEMENT
  NEWSLETTER
  FAQ
}

enum CommunicationStatus {
  DRAFT
  AI_ASSISTED
  HUMAN_REVIEW
  COMPLIANCE_REVIEW
  APPROVED
  REJECTED
}

enum ReviewDecision {
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum AggregateSentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
  MIXED
  UNKNOWN
}

enum GovernanceApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

model AuthUser {
  id                     String                   @id @default(uuid()) @db.Uuid
  email                  String                   @unique
  passwordHash           String                   @map("password_hash")
  displayName            String                   @map("display_name")
  emailVerifiedAt        DateTime?                @map("email_verified_at")
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")
  memberships            Membership[]
  sessions               AuthSession[]
  verificationKeys       EmailVerificationToken[]
  resetKeys              PasswordResetToken[]
  ledCampaigns           CampaignLeader[]
  ownedInitiatives       Initiative[]
  ownedActivities        Activity[]
  ownedTasks             CampaignTask[]
  uploadedDocuments      KnowledgeDocument[]
  aiConversations        AiConversation[]
  aiFeedback             AiFeedback[]
  createdPolicyCases     PolicyCase[]             @relation("PolicyCreator")
  policyRevisions        PolicyRevision[]         @relation("PolicyRevisionAuthor")
  policyApprovals        PolicyApproval[]         @relation("PolicyReviewer")
  createdCommunications  Communication[]          @relation("CommunicationCreator")
  communicationRevisions CommunicationRevision[]  @relation("CommunicationRevisionAuthor")
  communicationApprovals CommunicationApproval[]  @relation("CommunicationReviewer")

  @@map("auth_users")
}

model Organization {
  id               String            @id @default(uuid()) @db.Uuid
  name             String
  slug             String            @unique
  country          String
  isDemo           Boolean           @default(false) @map("is_demo")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  campaigns        Campaign[]
  memberships      Membership[]
  geographicLevels GeographicLevel[]
  volunteers       Volunteer[]
  aiConversations  AiConversation[]

  @@index([country])
  @@map("organizations")
}

model Campaign {
  id              String                @id @default(uuid()) @db.Uuid
  tenantId        String                @map("tenant_id") @db.Uuid
  name            String
  slug            String
  status          CampaignStatus        @default(DRAFT)
  isDemo          Boolean               @default(false) @map("is_demo")
  country         String
  electionType    String                @map("election_type")
  startsAt        DateTime?             @map("starts_at") @db.Date
  endsAt          DateTime?             @map("ends_at") @db.Date
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  organization    Organization          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leaders         CampaignLeader[]
  initiatives     Initiative[]
  activities      Activity[]
  tasks           CampaignTask[]
  events          CampaignEvent[]
  geographicAreas GeographicArea[]
  assignments     VolunteerAssignment[]
  documents       KnowledgeDocument[]
  aiConversations AiConversation[]
  policyCases     PolicyCase[]
  communications  Communication[]
  mediaItems      MediaItem[]

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@map("campaigns")
}

model KnowledgeDocument {
  id               String                   @id @default(uuid()) @db.Uuid
  tenantId         String                   @map("tenant_id") @db.Uuid
  campaignId       String                   @map("campaign_id") @db.Uuid
  uploadedById     String                   @map("uploaded_by_id") @db.Uuid
  title            String
  source           String?
  author           String?
  category         DocumentCategory
  tags             String[]
  visibility       DocumentVisibility       @default(CAMPAIGN)
  approvalStatus   DocumentApprovalStatus   @default(DRAFT) @map("approval_status")
  processingStatus DocumentProcessingStatus @default(PENDING) @map("processing_status")
  originalFilename String                   @map("original_filename")
  mediaType        String                   @map("media_type")
  fileExtension    String                   @map("file_extension")
  fileSizeBytes    Int                      @map("file_size_bytes")
  sha256           String
  storageKey       String                   @unique @map("storage_key")
  extractedText    String?                  @map("extracted_text")
  processingError  String?                  @map("processing_error")
  uploadedAt       DateTime                 @default(now()) @map("uploaded_at")
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")
  campaign         Campaign                 @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  uploadedBy       AuthUser                 @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  chunks           KnowledgeChunk[]

  @@unique([tenantId, campaignId, sha256])
  @@index([tenantId, campaignId, category, approvalStatus])
  @@index([tenantId, processingStatus, uploadedAt])
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id              String                       @id @default(uuid()) @db.Uuid
  tenantId        String                       @map("tenant_id") @db.Uuid
  documentId      String                       @map("document_id") @db.Uuid
  chunkIndex      Int                          @map("chunk_index")
  content         String
  tokenEstimate   Int                          @map("token_estimate")
  contentSha256   String                       @map("content_sha256")
  embeddingModel  String?                      @map("embedding_model")
  embedding       Unsupported("vector(1536)")?
  embeddingStatus String                       @default("PENDING") @map("embedding_status")
  metadata        Json?
  createdAt       DateTime                     @default(now()) @map("created_at")
  updatedAt       DateTime                     @updatedAt @map("updated_at")
  document        KnowledgeDocument            @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([tenantId, documentId])
  @@map("knowledge_chunks")
}

model AiConversation {
  id         String       @id @default(uuid()) @db.Uuid
  tenantId   String       @map("tenant_id") @db.Uuid
  campaignId String       @map("campaign_id") @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  title      String
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  tenant     Organization @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign   Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user       AuthUser     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   AiMessage[]

  @@index([tenantId, campaignId, userId, updatedAt])
  @@map("ai_conversations")
}

model AiMessage {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  conversationId String         @map("conversation_id") @db.Uuid
  role           AiMessageRole
  content        String
  intent         String?
  grounded       Boolean        @default(false)
  citations      Json?
  structuredData Json?          @map("structured_data")
  provider       String?
  model          String?
  providerRef    String?        @map("provider_ref")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  feedback       AiFeedback[]

  @@index([tenantId, conversationId, createdAt])
  @@map("ai_messages")
}

model AiFeedback {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  messageId String         @map("message_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  type      AiFeedbackType
  note      String?
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  message   AiMessage      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      AuthUser       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([tenantId, type, createdAt])
  @@map("ai_feedback")
}

model CampaignLeader {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  campaignId String   @map("campaign_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  title      String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user       AuthUser @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([campaignId, userId])
  @@index([tenantId, campaignId])
  @@map("campaign_leaders")
}

model Initiative {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  campaignId  String       @map("campaign_id") @db.Uuid
  ownerId     String?      @map("owner_id") @db.Uuid
  title       String
  description String?
  priority    WorkPriority @default(NORMAL)
  status      WorkStatus   @default(PLANNED)
  startsAt    DateTime?    @map("starts_at")
  dueAt       DateTime?    @map("due_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  campaign    Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  owner       AuthUser?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  activities  Activity[]

  @@index([tenantId, campaignId, status])
  @@map("initiatives")
}

model Activity {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  campaignId   String         @map("campaign_id") @db.Uuid
  initiativeId String?        @map("initiative_id") @db.Uuid
  ownerId      String?        @map("owner_id") @db.Uuid
  title        String
  description  String?
  priority     WorkPriority   @default(NORMAL)
  status       WorkStatus     @default(PLANNED)
  startsAt     DateTime?      @map("starts_at")
  dueAt        DateTime?      @map("due_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  campaign     Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  initiative   Initiative?    @relation(fields: [initiativeId], references: [id], onDelete: SetNull)
  owner        AuthUser?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  tasks        CampaignTask[]

  @@index([tenantId, campaignId, status])
  @@index([initiativeId])
  @@map("activities")
}

model CampaignTask {
  id           String                @id @default(uuid()) @db.Uuid
  tenantId     String                @map("tenant_id") @db.Uuid
  campaignId   String                @map("campaign_id") @db.Uuid
  activityId   String?               @map("activity_id") @db.Uuid
  ownerId      String?               @map("owner_id") @db.Uuid
  title        String
  description  String?
  priority     WorkPriority          @default(NORMAL)
  status       WorkStatus            @default(PLANNED)
  dueAt        DateTime?             @map("due_at")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")
  campaign     Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  activity     Activity?             @relation(fields: [activityId], references: [id], onDelete: SetNull)
  owner        AuthUser?             @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  dependencies TaskDependency[]      @relation("TaskDependencies")
  requiredBy   TaskDependency[]      @relation("TaskRequiredBy")
  assignments  VolunteerAssignment[]

  @@index([tenantId, campaignId, status, dueAt])
  @@index([activityId])
  @@map("campaign_tasks")
}

model TaskDependency {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  taskId          String       @map("task_id") @db.Uuid
  dependsOnTaskId String       @map("depends_on_task_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  task            CampaignTask @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn       CampaignTask @relation("TaskRequiredBy", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@index([tenantId, taskId])
  @@map("task_dependencies")
}

model CampaignEvent {
  id               String               @id @default(uuid()) @db.Uuid
  tenantId         String               @map("tenant_id") @db.Uuid
  campaignId       String               @map("campaign_id") @db.Uuid
  geographicAreaId String?              @map("geographic_area_id") @db.Uuid
  type             EventType
  title            String
  description      String?
  status           WorkStatus           @default(PLANNED)
  startsAt         DateTime             @map("starts_at")
  endsAt           DateTime?            @map("ends_at")
  venue            String?
  capacity         Int?
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  campaign         Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  geographicArea   GeographicArea?      @relation(fields: [geographicAreaId], references: [id], onDelete: SetNull)
  participants     EventParticipation[]

  @@index([tenantId, campaignId, startsAt])
  @@map("campaign_events")
}

model GeographicLevel {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  name         String
  orderIndex   Int              @map("order_index")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  organization Organization     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  areas        GeographicArea[]

  @@unique([tenantId, orderIndex])
  @@unique([tenantId, name])
  @@map("geographic_levels")
}

model GeographicArea {
  id         String           @id @default(uuid()) @db.Uuid
  tenantId   String           @map("tenant_id") @db.Uuid
  campaignId String           @map("campaign_id") @db.Uuid
  levelId    String           @map("level_id") @db.Uuid
  parentId   String?          @map("parent_id") @db.Uuid
  name       String
  code       String?
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  campaign   Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  level      GeographicLevel  @relation(fields: [levelId], references: [id], onDelete: Restrict)
  parent     GeographicArea?  @relation("AreaHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children   GeographicArea[] @relation("AreaHierarchy")
  events     CampaignEvent[]
  volunteers Volunteer[]

  @@unique([campaignId, levelId, parentId, name])
  @@index([tenantId, campaignId, parentId])
  @@map("geographic_areas")
}

model Volunteer {
  id                String                @id @default(uuid()) @db.Uuid
  tenantId          String                @map("tenant_id") @db.Uuid
  userId            String?               @map("user_id") @db.Uuid
  preferredAreaId   String?               @map("preferred_area_id") @db.Uuid
  displayName       String                @map("display_name")
  contactAuthorized Boolean               @default(false) @map("contact_authorized")
  email             String?
  phone             String?
  availability      Json
  languages         String[]
  skills            String[]
  trainingStatus    TrainingStatus        @default(NOT_STARTED) @map("training_status")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  organization      Organization          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  preferredArea     GeographicArea?       @relation(fields: [preferredAreaId], references: [id], onDelete: SetNull)
  assignments       VolunteerAssignment[]
  participation     EventParticipation[]

  @@index([tenantId, trainingStatus])
  @@map("volunteers")
}

model VolunteerAssignment {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  campaignId  String        @map("campaign_id") @db.Uuid
  volunteerId String        @map("volunteer_id") @db.Uuid
  taskId      String?       @map("task_id") @db.Uuid
  title       String
  status      WorkStatus    @default(PLANNED)
  startsAt    DateTime?     @map("starts_at")
  endsAt      DateTime?     @map("ends_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  campaign    Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  volunteer   Volunteer     @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  task        CampaignTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([tenantId, campaignId, volunteerId])
  @@map("volunteer_assignments")
}

model EventParticipation {
  id          String              @id @default(uuid()) @db.Uuid
  tenantId    String              @map("tenant_id") @db.Uuid
  eventId     String              @map("event_id") @db.Uuid
  volunteerId String              @map("volunteer_id") @db.Uuid
  status      ParticipationStatus @default(INVITED)
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  event       CampaignEvent       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  volunteer   Volunteer           @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@unique([eventId, volunteerId])
  @@index([tenantId, eventId])
  @@map("event_participation")
}

model Membership {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  role         MembershipRole
  status       MembershipStatus @default(ACTIVE)
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  organization Organization     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         AuthUser         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId, status])
  @@index([tenantId, role])
  @@map("memberships")
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  key             String           @unique
  description     String
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String         @id @default(uuid()) @db.Uuid
  role         MembershipRole
  permissionId String         @map("permission_id") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  permission   Permission     @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model AuthSession {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  userAgent  String?  @map("user_agent")
  ipHash     String?  @map("ip_hash")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  user      AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  user      AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model SecurityAuditEvent {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id") @db.Uuid
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId, createdAt])
  @@index([actorId, createdAt])
  @@map("security_audit_events")
}

model DataSource {
  id                   String                      @id @default(uuid()) @db.Uuid
  slug                 String                      @unique
  name                 String
  sourceType           String                      @map("source_type")
  attribution          String
  sourceUrl            String?                     @map("source_url")
  license              String?
  isPublic             Boolean                     @default(true) @map("is_public")
  createdAt            DateTime                    @default(now()) @map("created_at")
  updatedAt            DateTime                    @updatedAt @map("updated_at")
  imports              SurveyImport[]
  questions            SurveyQuestion[]
  indicatorDefinitions SurveyIndicatorDefinition[]

  @@map("data_sources")
}

model SurveyImport {
  id                    String                  @id @default(uuid()) @db.Uuid
  dataSourceId          String                  @map("data_source_id") @db.Uuid
  importVersion         String                  @map("import_version")
  surveyRound           String                  @map("survey_round")
  sourceFile            String                  @map("source_file")
  sourceSha256          String                  @unique @map("source_sha256")
  dictionaryFile        String                  @map("dictionary_file")
  dictionarySha256      String                  @map("dictionary_sha256")
  status                SurveyImportStatus      @default(PROCESSING)
  rowsInspected         Int                     @default(0) @map("rows_inspected")
  rowsImported          Int                     @default(0) @map("rows_imported")
  rejectedRows          Int                     @default(0) @map("rejected_rows")
  warnings              Json
  weightingFields       Json                    @map("weighting_fields")
  weightingValidation   Json                    @map("weighting_validation")
  transformationHistory Json                    @map("transformation_history")
  startedAt             DateTime                @default(now()) @map("started_at")
  completedAt           DateTime?               @map("completed_at")
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")
  dataSource            DataSource              @relation(fields: [dataSourceId], references: [id], onDelete: Restrict)
  countries             SurveyCountry[]
  questions             SurveyQuestion[]
  indicatorValues       SurveyIndicatorValue[]
  aggregateResults      SurveyAggregateResult[]

  @@unique([dataSourceId, importVersion])
  @@index([dataSourceId, surveyRound, status])
  @@map("survey_imports")
}

model SurveyQuestion {
  id                 String              @id @default(uuid()) @db.Uuid
  dataSourceId       String              @map("data_source_id") @db.Uuid
  surveyImportId     String              @map("survey_import_id") @db.Uuid
  surveyRound        String              @map("survey_round")
  questionCode       String              @map("question_code")
  questionText       String?             @map("question_text")
  dictionaryCategory String              @map("dictionary_category")
  dictionaryNote     String?             @map("dictionary_note")
  mappingStatus      SurveyMappingStatus @default(UNMAPPED) @map("mapping_status")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  dataSource         DataSource          @relation(fields: [dataSourceId], references: [id], onDelete: Restrict)
  surveyImport       SurveyImport        @relation(fields: [surveyImportId], references: [id], onDelete: Cascade)

  @@unique([surveyImportId, questionCode])
  @@index([dataSourceId, surveyRound, mappingStatus])
  @@map("survey_questions")
}

model SurveyCountry {
  id               String                  @id @default(uuid()) @db.Uuid
  surveyImportId   String                  @map("survey_import_id") @db.Uuid
  sourceCode       String                  @map("source_code")
  countryName      String                  @map("country_name")
  mappingStatus    SurveyMappingStatus     @default(UNMAPPED) @map("mapping_status")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")
  surveyImport     SurveyImport            @relation(fields: [surveyImportId], references: [id], onDelete: Cascade)
  regions          SurveyRegion[]
  indicatorValues  SurveyIndicatorValue[]
  aggregateResults SurveyAggregateResult[]

  @@unique([surveyImportId, sourceCode])
  @@map("survey_countries")
}

model SurveyRegion {
  id              String        @id @default(uuid()) @db.Uuid
  surveyCountryId String        @map("survey_country_id") @db.Uuid
  sourceCode      String        @map("source_code")
  regionName      String        @map("region_name")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  surveyCountry   SurveyCountry @relation(fields: [surveyCountryId], references: [id], onDelete: Cascade)

  @@unique([surveyCountryId, sourceCode])
  @@map("survey_regions")
}

model SurveyIndicatorDefinition {
  id               String                  @id @default(uuid()) @db.Uuid
  dataSourceId     String                  @map("data_source_id") @db.Uuid
  indicatorCode    String                  @unique @map("indicator_code")
  indicatorName    String                  @map("indicator_name")
  category         IntelligenceCategory
  questionCode     String                  @map("question_code")
  surveyRound      String                  @map("survey_round")
  responseMapping  Json                    @map("response_mapping")
  mappingVersion   String                  @map("mapping_version")
  isActive         Boolean                 @default(true) @map("is_active")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")
  dataSource       DataSource              @relation(fields: [dataSourceId], references: [id], onDelete: Restrict)
  values           SurveyIndicatorValue[]
  aggregateResults SurveyAggregateResult[]

  @@index([dataSourceId, category, isActive])
  @@map("survey_indicator_definitions")
}

model SurveyIndicatorValue {
  id                    String                    @id @default(uuid()) @db.Uuid
  surveyImportId        String                    @map("survey_import_id") @db.Uuid
  indicatorDefinitionId String                    @map("indicator_definition_id") @db.Uuid
  surveyCountryId       String                    @map("survey_country_id") @db.Uuid
  responseCode          String                    @map("response_code")
  weightedCount         Decimal                   @map("weighted_count") @db.Decimal(20, 8)
  totalWeight           Decimal                   @map("total_weight") @db.Decimal(20, 8)
  unweightedCount       Int                       @map("unweighted_count")
  weightField           String                    @map("weight_field")
  createdAt             DateTime                  @default(now()) @map("created_at")
  updatedAt             DateTime                  @updatedAt @map("updated_at")
  surveyImport          SurveyImport              @relation(fields: [surveyImportId], references: [id], onDelete: Cascade)
  indicatorDefinition   SurveyIndicatorDefinition @relation(fields: [indicatorDefinitionId], references: [id], onDelete: Restrict)
  surveyCountry         SurveyCountry             @relation(fields: [surveyCountryId], references: [id], onDelete: Cascade)

  @@unique([surveyImportId, indicatorDefinitionId, surveyCountryId, responseCode])
  @@index([surveyImportId, surveyCountryId])
  @@map("survey_indicator_values")
}

model SurveyAggregateResult {
  id                    String                    @id @default(uuid()) @db.Uuid
  surveyImportId        String                    @map("survey_import_id") @db.Uuid
  indicatorDefinitionId String                    @map("indicator_definition_id") @db.Uuid
  surveyCountryId       String                    @map("survey_country_id") @db.Uuid
  responseCode          String                    @map("response_code")
  weightedPercentage    Decimal?                  @map("weighted_percentage") @db.Decimal(8, 4)
  unweightedSampleSize  Int                       @map("unweighted_sample_size")
  minimumSampleSize     Int                       @map("minimum_sample_size")
  isSuppressed          Boolean                   @default(false) @map("is_suppressed")
  suppressionReason     String?                   @map("suppression_reason")
  weightField           String                    @map("weight_field")
  createdAt             DateTime                  @default(now()) @map("created_at")
  updatedAt             DateTime                  @updatedAt @map("updated_at")
  surveyImport          SurveyImport              @relation(fields: [surveyImportId], references: [id], onDelete: Cascade)
  indicatorDefinition   SurveyIndicatorDefinition @relation(fields: [indicatorDefinitionId], references: [id], onDelete: Restrict)
  surveyCountry         SurveyCountry             @relation(fields: [surveyCountryId], references: [id], onDelete: Cascade)

  @@unique([surveyImportId, indicatorDefinitionId, surveyCountryId, responseCode])
  @@index([surveyCountryId, isSuppressed, unweightedSampleSize])
  @@map("survey_aggregate_results")
}

model PolicyCase {
  id          String               @id @default(uuid()) @db.Uuid
  tenantId    String               @map("tenant_id") @db.Uuid
  campaignId  String               @map("campaign_id") @db.Uuid
  createdById String               @map("created_by_id") @db.Uuid
  title       String
  problem     String
  status      PolicyWorkflowStatus @default(PROBLEM)
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  campaign    Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdBy   AuthUser             @relation("PolicyCreator", fields: [createdById], references: [id], onDelete: Restrict)
  evidence    PolicyEvidence[]
  options     PolicyOption[]
  revisions   PolicyRevision[]
  approvals   PolicyApproval[]

  @@index([tenantId, campaignId, status, updatedAt])
  @@map("policy_cases")
}

model PolicyEvidence {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  policyCaseId String     @map("policy_case_id") @db.Uuid
  evidenceType String     @map("evidence_type")
  title        String
  source       String
  sourceUrl    String?    @map("source_url")
  summary      String
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  policyCase   PolicyCase @relation(fields: [policyCaseId], references: [id], onDelete: Cascade)

  @@index([tenantId, policyCaseId])
  @@map("policy_evidence")
}

model PolicyOption {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  policyCaseId String     @map("policy_case_id") @db.Uuid
  title        String
  description  String
  tradeoffs    String
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  policyCase   PolicyCase @relation(fields: [policyCaseId], references: [id], onDelete: Cascade)

  @@index([tenantId, policyCaseId])
  @@map("policy_options")
}

model PolicyRevision {
  id            String     @id @default(uuid()) @db.Uuid
  tenantId      String     @map("tenant_id") @db.Uuid
  policyCaseId  String     @map("policy_case_id") @db.Uuid
  authorId      String     @map("author_id") @db.Uuid
  version       Int
  content       String
  isAiGenerated Boolean    @default(false) @map("is_ai_generated")
  disclaimer    String?
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
