  createdById        String                  @map("created_by_id") @db.Uuid
  title              String
  type               CommunicationType
  status             CommunicationStatus     @default(DRAFT)
  complianceRequired Boolean                 @default(false) @map("compliance_required")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")
  campaign           Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  createdBy          AuthUser                @relation("CommunicationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  revisions          CommunicationRevision[]
  approvals          CommunicationApproval[]

  @@index([tenantId, campaignId, status, updatedAt])
  @@map("communications")
}

model CommunicationRevision {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  communicationId String        @map("communication_id") @db.Uuid
  authorId        String        @map("author_id") @db.Uuid
  version         Int
  content         String
  isAiGenerated   Boolean       @default(false) @map("is_ai_generated")
  disclaimer      String?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  communication   Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  author          AuthUser      @relation("CommunicationRevisionAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@unique([communicationId, version])
  @@index([tenantId, communicationId, createdAt])
