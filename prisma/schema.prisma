}

model CommunicationApproval {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  communicationId String         @map("communication_id") @db.Uuid
  reviewerId      String         @map("reviewer_id") @db.Uuid
  stage           String
  decision        ReviewDecision
  note            String?
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  communication   Communication  @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  reviewer        AuthUser       @relation("CommunicationReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([tenantId, communicationId, stage, createdAt])
  @@map("communication_approvals")
}

model AiProviderRecord {
  id          String       @id @default(uuid()) @db.Uuid
  providerKey String       @map("provider_key")
  modelKey    String       @map("model_key")
  displayName String       @map("display_name")
